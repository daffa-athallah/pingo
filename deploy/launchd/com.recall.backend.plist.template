<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.recall.backend</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>{{ROOT}}/deploy/run_backend.sh</string></array>
  <key>WorkingDirectory</key><string>{{ROOT}}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/recall/backend.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/recall/backend.log</string>
</dict></plist>
