<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.recall.hmem</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>{{ROOT}}/deploy/run_hmem.sh</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>WorkingDirectory</key><string>{{ROOT}}/engines/hmem</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/recall/hmem.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/recall/hmem.log</string>
</dict></plist>
