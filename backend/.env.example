# Production: Recall -> Meterless Nightshift -> NVIDIA Nemotron.
# Configure NVIDIA provider credentials INSIDE Nightshift, not in Recall.
METERLESS_BASE_URL=
METERLESS_API_KEY=
# Set from this Nightshift instance's /v1/models; do not assume raw NVIDIA IDs work.
METERLESS_MODEL=

# Evidence Agent perception model (non-NVIDIA, advertised by Nightshift) and Nemotron reasoning model.
METERLESS_VISION_MODEL=gpt-4o-mini
METERLESS_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Zetaris: use credentials for the installed instance, stored only in an ignored local file.
# On the Mac host:
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
# In a Docker Desktop backend container, override host with host.docker.internal.
ZETARIS_JDBC_JAR=/absolute/path/to/ndp-jdbc-driver.jar
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Set this to an existing JDK 11+ home on the host; the container will provide Java.
JAVA_HOME=

# Explicit offline recorded judge mode. No credentials or external calls in sample mode. Production never silently falls back to it.
SAMPLE_MODE=false

# Context delivery policy (actual wall-clock cooldown, even for synthetic inputs).
PINGO_NEARBY_STRONG_METERS=500
PINGO_NEARBY_MAX_METERS=1000
PINGO_NOTIFICATION_COOLDOWN_SECONDS=21600
PINGO_SNOOZE_SECONDS=86400
# Extra explicit origins for a separate development preview (comma-separated).
# HTTPS/mobile deployments should proxy /api on the same origin.
PINGO_FRONTEND_ORIGINS=

# Optional live memory sidecar (not needed in sample mode).
RECALL_HMEM_URL=
# Additional browser origins, comma-separated.
RECALL_CORS_ORIGINS=
RECALL_CORS_ORIGIN_REGEX=

# Cover photos (optional): Google Programmable Search (image search). Without these a card keeps its neutral icon.
# Create a key: console.cloud.google.com -> enable "Custom Search API" -> Credentials. Create an engine at programmablesearchengine.google.com
# with "Search the entire web" and "Image search" turned on; its ID is the CX. Free tier: 100 searches a day.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Automatic location tool after screenshot ingestion. No extra model calls.
# Public Nominatim is for small user-triggered lookups: one host, cache, <=1 request/sec.
# Review https://operations.osmfoundation.org/policies/nominatim/ before enabling.
RECALL_GEOCODE=off
RECALL_GEOCODE_URL=https://nominatim.openstreetmap.org/search
RECALL_GEOCODE_USER_AGENT=Pingo-Recall-hackathon/1.0 (https://github.com/daffa-athallah/recall)
# Optional provider response cache path; canonical entity metadata still lives in Zetaris.
RECALL_GEOCODE_CACHE_DIR=
