# NVIDIA — direct developer smoke test ONLY, never the production agent path.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Leave blank to attempt the preferred candidate; direct access was verified locally.
# Other credentials and Nightshift routes still require their own verification.
NVIDIA_MODEL=

# Production: Recall -> Meterless Nightshift -> NVIDIA Nemotron.
# Configure NVIDIA provider credentials INSIDE Nightshift, not in Recall.
METERLESS_BASE_URL=
METERLESS_API_KEY=
# Set from this Nightshift instance's /v1/models; do not assume raw NVIDIA IDs work.
METERLESS_MODEL=

# Evidence Agent perception model (non-NVIDIA, advertised by Nightshift) and Nemotron reasoning model.
METERLESS_VISION_MODEL=gpt-4o-mini
METERLESS_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Zetaris: use credentials for the installed instance, stored only in an ignored local file.
# On the Mac host:
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
# In a Docker Desktop backend container, override host with host.docker.internal.
ZETARIS_JDBC_JAR=/absolute/path/to/ndp-jdbc-driver.jar
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Set this to an existing JDK 11+ home on the host; the container will provide Java.
JAVA_HOME=

# Explicit offline judge/demo mode. Production never silently falls back to it.
SAMPLE_MODE=false
